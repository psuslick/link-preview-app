# Node / Vite / generated files
node_modules/
**/node_modules/
dist/
dist-ssr/
.cache/
.vite/
build/
coverage/
test-results/
playwright-report/

# Local profiles, caches, secrets, logs, downloaded/scraped media
.env
.env.*
!.env.example
*.local
*.log
*.log.*
logs/
cache/
caches/
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*.bak
*.png
*.jpg
*.jpeg
*.webp
*.mp4
screenshots/
*.key
*.pem
*.pfx
*.p12
*.crt

# Metadata/text from scraping should not accidentally become repository source.
*.json
*.txt
# Explicitly permit only source-controlled JSON manifests / npm metadata.
!package.json
!package-lock.json
!**/package.json
!**/package-lock.json
!/edge-tab-collector/manifest.json
!/server/index.json

# Do NOT check in personally customized Sandbox launchers, machine-specific
# mappings, profiles or payloads. Place those under LOCAL-ONLY-DO-NOT-COMMIT.
/LAUNCHER/LOCAL-ONLY-DO-NOT-COMMIT/
/BOOTSTRAP/LOCAL-ONLY-DO-NOT-COMMIT/
*.wsb
!/LAUNCHER/linkPreviewApp-hardened.wsb

# No portable tools, binaries, caches or archives committed to source Git.
/BOOTSTRAP/git/
/BOOTSTRAP/node/
/BOOTSTRAP/deps/
/BOOTSTRAP/SearXNGforWindows*/
*.zip
*.exe
*.msi

# Local editor/system files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
